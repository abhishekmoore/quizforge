# Server
PORT=4000

# Optional. If unset, quizzes are kept in memory and disappear when the server stops.
MONGO_URI=mongodb://127.0.0.1:27017/quizforge

# Optional. If unset, QuizForge uses a labeled offline quiz instead of a model.
# Any OpenAI-compatible API works: OpenAI, xAI, Groq, OpenRouter, a local server.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
